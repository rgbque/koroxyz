{
  "manifest_version": 3,
  "name": "KoroGold++",
  "version": "2.0.2",
  "description": "A Makeover for Korone, Inspired by KoroGold",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.pekora.zip/*",
    "https://pekora.zip/*",
    "https://www.korone.zip/*",
    "https://korone.zip/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pekora.zip/*",
        "https://pekora.zip/*",
        "https://www.korone.zip/*",
        "https://korone.zip/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "assets/*"],
      "matches": [
        "https://www.pekora.zip/*",
        "https://pekora.zip/*",
        "https://www.korone.zip/*",
        "https://korone.zip/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KoroXYZ Popup"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
